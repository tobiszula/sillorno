# Sillorno — cabeceras de caché.
# Sólo hace falta en hostings Apache (Hostinger y similares).
# En Vercel o Netlify este archivo se ignora, no molesta.

<IfModule mod_headers.c>
  # El código se revalida en cada visita: así un cambio se ve enseguida.
  <FilesMatch "\.(html|css|js|json|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Las imágenes casi no cambian: se cachean un mes.
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

ErrorDocument 404 /index.html

# Cada producto tiene su dirección propia (/producto/frazada-microfibra).
# El sitio es una sola página, así que cualquier ruta de producto se sirve
# con el index y el JavaScript se encarga de abrir la ficha.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^producto/[^/]+/?$ /index.html [L]
</IfModule>
